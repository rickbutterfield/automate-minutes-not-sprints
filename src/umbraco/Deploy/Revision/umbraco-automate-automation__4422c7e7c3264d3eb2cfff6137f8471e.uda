      "Filter": null
    },
    {
      "SourceStepId": "8850b2ba-9b5c-4cf3-9de3-c0e2408bc405",
      "SourceHandle": "approved",
      "TargetStepId": "590c6203-1b13-4950-93e5-cb6ee14068d5",
      "TargetHandle": null,
      "Outcome": "approved",
      "Filter": null
    },
    {
      "SourceStepId": "8850b2ba-9b5c-4cf3-9de3-c0e2408bc405",
      "SourceHandle": "rejected",
      "TargetStepId": "d8bd4292-247f-47fe-bd8e-46ba6404dddd",
