    }
  ],
  "CanvasState": "{\u0022viewport\u0022:{\u0022x\u0022:613.5,\u0022y\u0022:439.95,\u0022zoom\u0022:0.85},\u0022triggerPosition\u0022:{\u0022x\u0022:-124,\u0022y\u0022:0}}",
  "Udi": "umb://umbraco-automate-automation/4422c7e7c3264d3eb2cfff6137f8471e",
