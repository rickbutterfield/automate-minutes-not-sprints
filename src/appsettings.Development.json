{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=(localdb)\\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\\Umbraco.mdf;Integrated Security=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Umbraco": {
    "CMS": {
      "Content": {
        "MacroErrors": "Throw"
      },
      "Runtime": {
        "Mode": "BackofficeDevelopment"
      },
      "Hosting": {
        "Debug": true
      },
      "RuntimeMinification": {
        "UseInMemoryCache": true,
        "CacheBuster": "Timestamp"
      },
      "Webhook": {
        "Enabled": false
      },
      "Global": {
        "TimeOut": "1.00:00:00",
        "Smtp": {
          "From": "travelclub@example.com",
          "Host": "localhost",
          "Port": 25,
          "SecureSocketOptions": "None"
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "1234567890",
        "UnattendedTelemetryLevel": "Detailed"
      }
    },
    "Automate":{
      "UseNamedConnectionString": "umbracoDbDSN"
    }
  },
  "Demo": {
    "McpApiUser": {
      "Name": "MCP",
      "Email": "mcp@example.com",
      "ClientId": "umbraco-back-office-mcp",
      "ClientSecret": ""
    },
    "AutomateServiceUser": {
      "Name": "Automate Service",
      "Email": "automate@example.com"
    }
  }
}